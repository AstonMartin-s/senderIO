# === Base de datos (Postgres) ===
# Local (Homebrew PostgreSQL 16): el usuario por defecto es tu usuario de macOS.
DATABASE_URL=postgresql://localhost:5432/senderio

# === Kommo — Mooney (cuenta histórica; estas vars = cliente mooney) ===
# Subdominio de tu cuenta (https://<subdominio>.kommo.com)
KOMMO_SUBDOMAIN=mooneyatkinson
# Token long-lived de una integración privada de Kommo (Authorization: Bearer <token>)
KOMMO_TOKEN=
# Secreto opcional para validar el webhook entrante
KOMMO_WEBHOOK_SECRET=
# ID del campo personalizado PLANTILLA_ENVIADA (opcional)
# KOMMO_CF_PLANTILLA_ID=
# Modo de cliente Kommo: "real" pega contra la API, "mock" simula leads en memoria
KOMMO_MODE=mock

# === Kommo — King (servicio paralelo; otra cuenta) ===
# Webhook de King: POST /webhook/kommo/king
KOMMO_KING_SUBDOMAIN=
KOMMO_KING_TOKEN=
KOMMO_KING_WEBHOOK_SECRET=
# KOMMO_KING_CF_PLANTILLA_ID=

# === API ===
API_PORT=3000
# Panel principal de operación (HTTP Basic Auth). Default local admin/admin321.
# En prod CRED carga los reales en Railway; no pegar el pass en git (R7).
ADMIN_USER=admin
ADMIN_PASSWORD=admin321

# === Zona horaria de la operación ===
TZ=America/Argentina/Cordoba

# === Programa Trazabilidad (push automático de envíos) ===
TRAZABILIDAD_API_URL=http://127.0.0.1:8000
TRAZABILIDAD_INGEST_API_KEY=
TRAZABILIDAD_PUSH_ENABLED=false

# === Control / Trazabilidad nueva (GET /traza/v1/feed) ===
# Bearer de máquina (scope traza:feed). Lo carga CRED. Vacío = feed_disabled (503).
# TRAZA_FEED_TOKEN=

# === Panel-cliente (paquete vendido; /cliente) ===
# id del cliente en tabla clients (default clienteS1) y token de acceso opaco.
# Vacío = panel deshabilitado (503). Lo carga CRED. No pegar el token en git.
CLIENTE_PANEL_ID=clienteS1
# CLIENTE_PANEL_TOKEN=
